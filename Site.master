<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="LeftoverFood.SiteMaster" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>
  <link href="~/assets/css/style.css" runat="server" rel="stylesheet"/>
  <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body style="background:var(--cream)">
<form id="form1" runat="server">
<div class="fb-layout">

  <asp:ContentPlaceHolder ID="SidebarContent" runat="server" />

  <!-- MAIN -->
  <div class="fb-main">
    <div class="fb-topbar">
      <button id="sidebarToggle" type="button" class="d-lg-none btn btn-sm btn-light border me-2"><i class="bi bi-list"></i></button>
      <span style="font-family:'DM Serif Display',serif;font-size:1.2rem;flex:1"><asp:ContentPlaceHolder ID="PageHeading" runat="server" /></span>
      <div class="fb-topbar-actions">
        <%-- Was a plain <input> with no name, no handler and no destination —
             decorative on every page in the app. DefaultButton makes Enter
             submit this box specifically, rather than whichever button the
             hosting page happens to declare first. --%>
        <asp:Panel runat="server" ID="pnlSearch" CssClass="search-wrap" DefaultButton="btnSearch">
          <asp:LinkButton runat="server" ID="btnSearch" OnClick="btnSearch_Click"
                          ToolTip="Search" Style="z-index:2"><i class="bi bi-search"></i></asp:LinkButton>
          <asp:TextBox runat="server" ID="txtSearch" CssClass="fb-search" placeholder="Search donations…" />
        </asp:Panel>
        <%-- Phase 4: was a static bell with a permanently-lit dot. Now a real
             link to the shared notifications page, with a live unread count. --%>
        <a class="notif-btn" runat="server" id="notifBell" href="~/Notifications.aspx"
           style="text-decoration:none;color:inherit">
          <i class="bi bi-bell"></i>
          <asp:Literal runat="server" ID="litBellBadge" />
        </a>
        <div class="fb-avatar" runat="server" id="topbarAvatar"></div>
      </div>
    </div>

    <div class="fb-content">
      <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </div>
  </div>
</div>
</form>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="<%= ResolveUrl("~/assets/js/main.js") %>"></script>
<asp:ContentPlaceHolder ID="FooterScripts" runat="server" />
</body>
</html>
