<?xml version="1.0" encoding="utf-8"?>

<!-- ===================================================================
     DEPLOYMENT TRANSFORM

     These values replace the ones in Web.config when the project is
     published in the *Release* configuration. Web.config itself keeps the
     local development settings, so local debugging keeps working untouched
     and there is no config file to remember to swap back.

     BEFORE THE FIRST PUBLISH, fill in the four placeholders below with the
     values from the MonsterASP control panel:

       SQL_SERVER_HOST   Databases -> your database -> server address
       DB_NAME           the database name shown there
       DB_USER           the login shown there
       DB_PASSWORD       the password shown there
       YOURSITE          your free subdomain, e.g. foodbridge.runasp.net

     IMPORTANT: this only takes effect on a *Release publish*. Copying the
     raw project files over FTP skips transforms entirely and the site would
     start up pointing at Elitebook\SQLEXPRESS, which does not exist on the
     host — every page would fail on its first query.

     See DEPLOYMENT.md for the full checklist.
     =================================================================== -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <!-- The local strings use Integrated Security (Windows auth against
       Elitebook\SQLEXPRESS). Neither the machine nor Windows auth exists on
       shared hosting, so both strings move to SQL authentication.

       Both names are transformed because the app reads both: DBHelper uses
       FoodDB, and MyDbConnection is referenced elsewhere. Leaving one behind
       would work until the first page that happens to use it. -->
  <connectionStrings>
    <!-- Password is single-quote-wrapped because it contains a literal "="
         (T#s4c5=EQg9?), which the connection-string parser would otherwise
         read as the start of a new key. Single quotes, not double — the XML
         attribute itself is double-quoted, so a literal " here would need
         &quot; escaping instead; ' needs none. -->
    <add name="MyDbConnection"
         connectionString="Data Source=db64189.databaseasp.net;Initial Catalog=db64189;User ID=db64189;Password='T#s4c5=EQg9?';Encrypt=False;TrustServerCertificate=True"
         providerName="System.Data.SqlClient"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />

    <add name="FoodDB"
         connectionString="Data Source=db64189.databaseasp.net;Initial Catalog=db64189;User ID=db64189;Password='T#s4c5=EQg9?';Encrypt=False;TrustServerCertificate=True"
         providerName="System.Data.SqlClient"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>

  <appSettings>
    <!-- Only used for notifications raised without a request context —
         NotificationService now derives the base URL from the live request
         whenever there is one, so a wrong value here no longer breaks every
         email link. Still worth setting correctly.

         Must be https, and must end with a slash. -->
    <add key="App.BaseUrl" value="https://foodbridge.runasp.net/"
         xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />

    <!-- Nominatim's usage policy requires a contact address that is actually
         monitored, and identifying the deployed site separately from the
         development one makes the source of any traffic obvious if they ever
         ask. Same email, different label. -->
    <add key="Geocoding.UserAgent"
         value="FoodBridge-FYP/1.0 (+https://foodbridge.runasp.net; finalyearproject375@gmail.com)"
         xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>

  <system.web>
    <!-- Removes debug="true". Debug builds are slower, use more memory (which
         matters on a 256 MB plan) and can leak source paths in stack traces. -->
    <compilation xdt:Transform="RemoveAttributes(debug)" />
  </system.web>

</configuration>
