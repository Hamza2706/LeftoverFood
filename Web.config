<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
	<connectionStrings>
		<add name="MyDbConnection"
			 connectionString="Data Source=Elitebook\SQLEXPRESS;Initial Catalog=LeftoverFood;Integrated Security=True;Encrypt=False;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient" />
		
		<add name="FoodDB"
			 connectionString="Data Source=Elitebook\SQLEXPRESS;Initial Catalog=LeftoverFood;Integrated Security=True;Encrypt=False;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<!-- ===================================================================
	     Phase 4 — Notification email (SMTP)

	     Notifications ALWAYS write a row to the Notifications table. Email is
	     a best-effort second channel on top of that: if SMTP is misconfigured
	     or offline, NotificationService swallows the error and the in-app
	     notification still lands. Nothing here can break a donation flow.

	     TO TURN EMAIL ON:
	       1. Generate a Gmail App Password (Google Account > Security >
	          2-Step Verification > App passwords). A normal account password
	          will NOT work — Google blocks it.
	       2. Put the Gmail address in Smtp.User and Smtp.FromAddress.
	       3. Paste the 16-character app password into Smtp.Password.
	       4. Set Smtp.Enabled to "true".

	     Leave Smtp.Enabled as "false" and email is skipped entirely — the app
	     runs fine, notifications just stay in-app only.

	     NOTE: this file is committed to git. Do not commit a real app
	     password. Keep Smtp.Password as the placeholder in commits and set the
	     real value only in your local working copy.
	     =================================================================== -->
	<appSettings>
		<add key="Smtp.Enabled"     value="true" />
		<add key="Smtp.Host"        value="smtp.gmail.com" />
		<add key="Smtp.Port"        value="587" />
		<add key="Smtp.EnableSsl"   value="true" />
		<add key="Smtp.User"        value="finalyearproject375@gmail.com" />
		<add key="Smtp.Password"    value="igru wpju yzqn hiil" />
		<add key="Smtp.FromAddress" value="finalyearproject375@gmail.com" />
		<add key="Smtp.FromName"    value="FoodBridge" />

		<!-- Used to build absolute links inside emails (in-app links are
		     relative and don't need this). Include the trailing slash.

		     Must match the URL the site is actually served on, or every link
		     in a notification email 404s. This is the project's IISUrl from
		     LeftoverFood.csproj — the address Visual Studio launches.
		     IIS Express also binds http://localhost:50555/ per
		     .vs/LeftoverFood.slnx/config/applicationhost.config, so use that
		     instead if you run without SSL. Change this when you deploy. -->
		<add key="App.BaseUrl"      value="https://localhost:44309/" />

		<!-- ===============================================================
		     Phase 5 — Maps (OpenStreetMap / Leaflet / Nominatim)

		     No API key and no billing account is needed. In exchange we have
		     to honour Nominatim's usage policy, which the code enforces:
		       - an identifying User-Agent with a real contact (required —
		         requests without one are refused)
		       - at most 1 request per second (GeocodingService.Throttle)
		       - cache results instead of re-requesting (GeocodeCache table)

		     If you ever switch to a paid provider, only these keys and the
		     tile URL below change.
		     =============================================================== -->
		<add key="Geocoding.UserAgent"    value="FoodBridge-FYP/1.0 (finalyearproject375@gmail.com)" />
		<!-- Biases geocoding to Pakistan; without it, bare area names match
		     similarly-named places in other countries. -->
		<add key="Geocoding.CountryCodes" value="pk" />
		<!-- Map fallback centre (Karachi) for when a donation has no
		     coordinates yet. -->
		<add key="Map.DefaultLat"         value="24.8607" />
		<add key="Map.DefaultLng"         value="67.0011" />
		<add key="Map.TileUrl"            value="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png" />
		<add key="Map.Attribution"        value="&amp;copy; OpenStreetMap contributors" />
		<!-- How often a tracking page asks for the volunteer's latest position. -->
		<add key="Map.PollSeconds"        value="20" />
	</appSettings>

  <system.web>
	  <!-- Session configuration: 30-minute timeout, cookie-based -->
	  <sessionState mode="InProc" timeout="30" cookieless="false" />

	  <!-- Custom error pages -->
	  <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" />

	  <!-- Authentication: Forms-based login -->
	  <authentication mode="Forms">
		  <forms loginUrl="~/Login.aspx" timeout="30" />
	  </authentication>
	  
	  <!--<validation validateIntegratedModeConfiguration="false" />-->
	  <pages clientIDMode="AutoID">
		  <controls>
			  <!-- Registered here rather than with a <%@ Register %> directive in
			       each file, so the five pages/masters that render the sidebar
			       don't each need their own declaration. -->
			  <add tagPrefix="fb" tagName="RoleSidebar" src="~/Controls/RoleSidebar.ascx" />
		  </controls>
	  </pages>

	  <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
  </system.web>
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" />
    </compilers>
  </system.codedom>
</configuration>